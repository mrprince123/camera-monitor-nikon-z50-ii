<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB host mode -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <!-- Audio & Camera permissions needed for USB video/audio composite devices (e.g. Nikon Z50 II) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="CamMonitor"
        android:theme="@style/Theme.CameraMonitor"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize"
            android:keepScreenOn="true">

            <!-- Standard launcher entry -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Plug-and-play: Android launches (or brings to front) this activity
                automatically when a USB device is attached in host mode.
                android.hardware.usb.action.USB_DEVICE_ATTACHED is the correct action.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>
    </application>
</manifest>
