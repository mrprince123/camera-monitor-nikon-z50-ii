<?xml version="1.0" encoding="utf-8"?>
<!--
    Modern squircle background for camera-style icon toggle buttons (ZineControl style).
    Checked  → bright luminous yellow (#FFC400)
    Pressed  → translucent bright yellow (#4DFFC400) with yellow border
    Default  → dark quiet translucent glass (#B3161A22) with subtle rounded border
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Active / checked (Lights up bright yellow) -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFC400" />
            <stroke android:width="1.5dp" android:color="#FFFFD54F" />
        </shape>
    </item>

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#4DFFC400" />
            <stroke android:width="1.5dp" android:color="#FFFFC400" />
        </shape>
    </item>

    <!-- Default / unchecked (Dark and quiet) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#B3161A22" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>

</selector>
