<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- ── Live camera feed container ── -->
    <FrameLayout
        android:id="@+id/cameraViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ── Analysis overlay: grid / level / histogram / zebra / peaking ── -->
    <com.example.cameramonitor.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ════════════════════════════════════════════════════════
         SPLASH / WAITING SCREEN
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/splashLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FF0D1117"
        android:visibility="visible">

        <!-- App icon (camera aperture logo) -->
        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_splash_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="22dp" />

        <!-- App name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CamMonitor"
            android:textColor="#E8EEF6"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="6dp" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nikon Z50 II · Field Monitor"
            android:textColor="#4466889A"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="44dp" />

        <!-- Status pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1AFFFFFF"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔌"
                android:textSize="18sp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect your camera"
                android:textColor="#88AABFCE"
                android:textSize="14sp"
                android:letterSpacing="0.02" />
        </LinearLayout>

    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════
         CAMERA-STYLE ICON CONTROL PANEL (right side, vertical)
         Tap anywhere on the screen to show/hide.
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- ── Grid button ── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <CheckBox
                android:id="@+id/tgGrid"
                style="@style/IconToggleButton"
                android:drawableTop="@drawable/ic_grid" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GRID"
                android:textColor="#77FFFFFF"
                android:textSize="8sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- ── Level button ── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <CheckBox
                android:id="@+id/tgLevel"
                style="@style/IconToggleButton"
                android:drawableTop="@drawable/ic_level" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LEVEL"
                android:textColor="#77FFFFFF"
                android:textSize="8sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- ── Histogram button ── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <CheckBox
                android:id="@+id/tgHist"
                style="@style/IconToggleButton"
                android:drawableTop="@drawable/ic_histogram" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HISTO"
                android:textColor="#77FFFFFF"
                android:textSize="8sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- ── Zebra button ── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <CheckBox
                android:id="@+id/tgZebra"
                style="@style/IconToggleButton"
                android:drawableTop="@drawable/ic_zebra" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZEBRA"
                android:textColor="#77FFFFFF"
                android:textSize="8sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- ── Focus Peaking button ── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <CheckBox
                android:id="@+id/tgPeak"
                style="@style/IconToggleButton"
                android:drawableTop="@drawable/ic_focus" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOCUS"
                android:textColor="#77FFFFFF"
                android:textSize="8sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="3dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
