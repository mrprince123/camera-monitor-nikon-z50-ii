<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B0E"
    android:keepScreenOn="true">

    <!-- ── Live camera feed container ── -->
    <FrameLayout
        android:id="@+id/cameraViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- ── Analysis overlay: grid / level / histogram / zebra / peaking ── -->
    <com.example.cameramonitor.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ════════════════════════════════════════════════════════
         TOP ACTIONS BAR (Status Badge + LOGS + HUD)
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <!-- STATUS BADGE (ZineControl style: glowing dot + "CONNECTED" in bright yellow) -->
        <LinearLayout
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <!-- Glowing indicator dot -->
            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot_disconnected"
                android:layout_marginEnd="8dp" />

            <!-- Status text -->
            <TextView
                android:id="@+id/statusBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISCONNECTED"
                android:textColor="#FFFFC400"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- RECORDING BANNER (ZineControl style: Blinking dot + REC 00:00) -->
        <LinearLayout
            android:id="@+id/recordingBanner"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="10dp"
            android:visibility="gone">

            <View
                android:id="@+id/recDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot_disconnected"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvRecTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REC 00:00"
                android:textColor="#FFFF4D4D"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- GALLERY / MEDIA BROWSER BUTTON -->
        <LinearLayout
            android:id="@+id/btnOpenGallery"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_log_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_gallery"
                android:tint="#FFFFC400" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="SD MEDIA"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- LOGS BUTTON -->
        <LinearLayout
            android:id="@+id/btnOpenLogs"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_log_pill"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_logs"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOGS"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- HUD TOGGLE BUTTON -->
        <LinearLayout
            android:id="@+id/btnToggleHud"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_log_pill"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HUD"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>
    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════
         DIAGNOSTIC HUD PANEL (real-time stream metrics)
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/hudPanel"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="54dp"
        android:background="@drawable/bg_control_bar"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hudTvState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USB State: DISCONNECTED"
            android:textColor="#FFFFC400"
            android:textSize="10.5sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hudTvDevice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device: None"
            android:textColor="#E2E8F0"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/hudTvResolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Format: 1280x720 MJPEG"
            android:textColor="#E2E8F0"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/hudTvFrames"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frames: 0 (0 fps)"
            android:textColor="#FF00E676"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/hudTvSurface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Surface: Waiting"
            android:textColor="#E2E8F0"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/hudTvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last Error: None"
            android:textColor="#FFFF4D4D"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:layout_marginTop="3dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════
         CAMERA-STYLE ICON CONTROL PANEL (ZineControl style)
         Translucent dark panel with soft rounded corners (24dp)
         Landscape: Vertical bar on right side
         Portrait:  Horizontal bar at bottom
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_control_bar"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="visible">

        <!-- ── Grid button ── -->
        <LinearLayout
            android:id="@+id/itemGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <CheckBox
                android:id="@+id/tgGrid"
                style="@style/IconToggleButton"
                android:drawableTop="@drawable/ic_grid" />

            <TextView
                android:id="@+id/lblGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GRID"
                android:textColor="@color/label_tint"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ── Level button ── -->
        <LinearLayout
            android:id="@+id/itemLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <CheckBox
                android:id="@+id/tgLevel"
                style="@style/IconToggleButton"
                android:drawableTop="@drawable/ic_level" />

            <TextView
                android:id="@+id/lblLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LEVEL"
                android:textColor="@color/label_tint"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ── Histogram button ── -->
        <LinearLayout
            android:id="@+id/itemHist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <CheckBox
                android:id="@+id/tgHist"
                style="@style/IconToggleButton"
                android:drawableTop="@drawable/ic_histogram" />

            <TextView
                android:id="@+id/lblHist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HISTO"
                android:textColor="@color/label_tint"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ── Zebra button ── -->
        <LinearLayout
            android:id="@+id/itemZebra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <CheckBox
                android:id="@+id/tgZebra"
                style="@style/IconToggleButton"
                android:drawableTop="@drawable/ic_zebra" />

            <TextView
                android:id="@+id/lblZebra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZEBRA"
                android:textColor="@color/label_tint"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ── Focus Peaking button ── -->
        <LinearLayout
            android:id="@+id/itemPeak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <CheckBox
                android:id="@+id/tgPeak"
                style="@style/IconToggleButton"
                android:drawableTop="@drawable/ic_focus" />

            <TextView
                android:id="@+id/lblPeak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOCUS"
                android:textColor="@color/label_tint"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ── False Color button ── -->
        <LinearLayout
            android:id="@+id/itemFalseColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <CheckBox
                android:id="@+id/tgFalseColor"
                style="@style/IconToggleButton"
                android:drawableTop="@drawable/ic_false_color" />

            <TextView
                android:id="@+id/lblFalseColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FALSE"
                android:textColor="@color/label_tint"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ── Waveform button ── -->
        <LinearLayout
            android:id="@+id/itemWaveform"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <CheckBox
                android:id="@+id/tgWaveform"
                style="@style/IconToggleButton"
                android:drawableTop="@drawable/ic_waveform" />

            <TextView
                android:id="@+id/lblWaveform"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WAVE"
                android:textColor="@color/label_tint"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ── Aspect Ratio Guides button ── -->
        <LinearLayout
            android:id="@+id/itemGuides"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <CheckBox
                android:id="@+id/tgGuides"
                style="@style/IconToggleButton"
                android:drawableTop="@drawable/ic_guides" />

            <TextView
                android:id="@+id/lblGuides"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUIDE"
                android:textColor="@color/label_tint"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════
         QUICK SETTING SELECTOR MODAL DIALOG
    ════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/settingModalContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_log_dialog"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvSettingModalTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SELECT VALUE"
                    android:textColor="#FFFFC400"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/btnCloseSettingModal"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_log_pill"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settingOptionsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp" />
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- ════════════════════════════════════════════════════════
         SD CARD MEDIA BROWSER MODAL (Phase 6)
    ════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/galleryModalContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:background="@drawable/bg_log_dialog"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvGalleryTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Camera SD Card Media"
                    android:textColor="#FFFFC400"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <!-- Refresh Button -->
                <TextView
                    android:id="@+id/btnRefreshGallery"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="REFRESH"
                    android:textColor="#FFFFC400"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_log_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <!-- Close Button -->
                <TextView
                    android:id="@+id/btnCloseGallery"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_log_pill"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Loading indicator / empty message -->
            <TextView
                android:id="@+id/tvGalleryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading media from camera SD card…"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:visibility="gone" />

            <!-- Media Items ScrollView / Flex -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#E607090C"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/galleryItemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- ════════════════════════════════════════════════════════
         SPLASH / WAITING SCREEN (Modern Yellow & Charcoal Design)
    ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/splashLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FF0A0B0E"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <!-- App icon (Modern lens camera logo with soft rounded corners) -->
        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:src="@drawable/ic_splash_logo"
            android:scaleType="fitCenter"
            android:clipToOutline="true"
            android:background="@drawable/bg_splash_logo"
            android:layout_marginBottom="24dp" />

        <!-- App name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CamMonitor"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="6dp" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nikon Z50 II · Field Monitor"
            android:textColor="#9AA2B3"
            android:textSize="13sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="36dp" />

        <!-- Status pill with yellow accent -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="18sp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect your camera"
                android:textColor="#FFFFC400"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />
        </LinearLayout>

    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════
         DIAGNOSTIC LOGS MODAL DIALOG (Yellow & Charcoal Theme)
    ════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/logModalContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:background="@drawable/bg_log_dialog"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Diagnostic Logs"
                    android:textColor="#FFFFC400"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <!-- Copy All Button -->
                <LinearLayout
                    android:id="@+id/btnCopyLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_action_btn"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_copy"
                        android:tint="#FF0A0B0E"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvCopyLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COPY ALL"
                        android:textColor="#FF0A0B0E"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Clear Button -->
                <TextView
                    android:id="@+id/btnClearLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="CLEAR"
                    android:textColor="#AAFFFFFF"
                    android:textSize="11sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/bg_log_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <!-- Close Button -->
                <TextView
                    android:id="@+id/btnCloseLogs"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_log_pill"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Console Log ScrollView -->
            <ScrollView
                android:id="@+id/logScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#E607090C"
                android:padding="12dp"
                android:fadeScrollbars="false">

                <TextView
                    android:id="@+id/tvLogContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#FFFFC400"
                    android:textSize="11sp"
                    android:textIsSelectable="true"
                    android:lineSpacingExtra="2dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
